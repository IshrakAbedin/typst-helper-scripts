// Resolve a language tag (e.g. "py", "c++") to a key in `icons`.
#let resolve-lang(lang) = {
  let l = lower(lang)
  if l in icons { l } else if l in aliases { aliases.at(l) } else { none }
}

#let has-icon(lang) = resolve-lang(lang) != none

/// Icon for a language, or `fallback` (default: the language name as text).
#let lang-icon(lang, height: 1em, color: black, fallback: auto) = {
  let key = resolve-lang(lang)
  if key == none {
    return if fallback == auto { text(fill: color, lang) } else { fallback }
  }
  let svg = icons.at(key).svg.replace("currentColor", color.to-hex())
  box(height: height, image(bytes(svg), format: "svg", height: height))
}
